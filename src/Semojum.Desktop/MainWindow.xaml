<Window x:Class="Semojum.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:svg="http://sharpvectors.codeplex.com/svgc/" xmlns:local="clr-namespace:Semojum.Desktop.Controls"
        Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Width="1440" Height="1000" MinWidth="1280" MinHeight="800" WindowStartupLocation="CenterScreen" Closing="Window_Closing" UseLayoutRounding="True">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>

        <Menu Height="32" FontSize="12" Padding="0">
          <MenuItem Header="파일(_F)">
            <MenuItem Header="새 문서" InputGestureText="Ctrl+N" Tag="new" Click="Action_Click"/>
            <MenuItem Header="열기…" InputGestureText="Ctrl+O" Tag="open" Click="Action_Click"/>
            <MenuItem x:Name="RecentFilesMenu" Header="최근 문서" SubmenuOpened="RecentFiles_Opened"><MenuItem Header="최근 작업 파일이 없습니다" IsEnabled="False"/></MenuItem>
            <MenuItem Header="작업 폴더 선택…" Tag="workFolder" Click="Action_Click"/>
            <MenuItem Header="마지막 작업 폴더 열기…" Tag="lastFolder" Click="Action_Click"/>
            <MenuItem Header="문서 업로드·AI 변환…" Tag="upload" Click="Action_Click"/>
            <MenuItem Header="서버 작업 열기…" Tag="serverOpen" Click="Action_Click"/>
            <MenuItem Header="현재 작업 변환 중단" Tag="cancelJob" Click="Action_Click"/>
            <MenuItem Header="쪽별 변환 상태…" Tag="pageStatus" Click="Action_Click"/>
            <Separator/><MenuItem Header="저장" InputGestureText="Ctrl+S" Tag="save" Click="Action_Click"/>
            <MenuItem Header="다른 이름으로 저장…" Tag="saveAs" Click="Action_Click"/>
            <MenuItem Header="문서 최적화·출력 설정…" Tag="optimize" Click="Action_Click"/>
            <MenuItem Header="점자 면 미리보기·인쇄…" Tag="composition" Click="Action_Click"/>
            <MenuItem Header="문서 내보내기…" Tag="export" Click="Action_Click"/>
            <Separator/><MenuItem Header="샘플 문서 다시 열기" Tag="sample" Click="Action_Click"/>
            <MenuItem Header="문서 닫기" InputGestureText="Ctrl+W" Tag="closeDocument" Click="Action_Click"/>
            <MenuItem Header="종료" Tag="close" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="편집(_E)">
            <MenuItem Header="되돌리기" InputGestureText="Ctrl+Z" Tag="undo" Click="Action_Click"/><MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Tag="redo" Click="Action_Click"/>
            <Separator/><MenuItem Header="잘라내기" Tag="cut" Click="Action_Click"/><MenuItem Header="복사" Tag="copy" Click="Action_Click"/><MenuItem Header="붙여넣기" Tag="paste" Click="Action_Click"/>
            <Separator/><MenuItem Header="찾아 바꾸기…" InputGestureText="Ctrl+F" Tag="find" Click="Action_Click"/>
            <MenuItem Header="다음 찾기" InputGestureText="F3" Tag="findNext" Click="Action_Click"/>
            <MenuItem Header="바꾸기…" InputGestureText="Ctrl+H" Tag="replace" Click="Action_Click"/>
            <MenuItem Header="이동…" InputGestureText="Ctrl+G" Tag="goto" Click="Action_Click"/>
            <MenuItem Header="새 블록 추가" InputGestureText="Ctrl+Enter" Tag="addBlock" Click="Action_Click"/>
            <MenuItem Header="현재 쪽 블록 선택…" Tag="selectBlocks" Click="Action_Click"/>
            <MenuItem Header="블록 내용 비우기" Tag="clearBlock" Click="Action_Click"/>
            <MenuItem Header="블록 삭제" Tag="deleteBlock" Click="Action_Click"/>
            <MenuItem Header="현재 줄 지우기" Tag="clearLine" Click="Action_Click"/>
            <MenuItem Header="점자 규정…" Tag="rules" Click="Action_Click"/>
            <MenuItem Header="표 구조 편집…" Tag="table" Click="Action_Click"/>
            <MenuItem Header="메모 목록…" Tag="memos" Click="Action_Click"/>
            <MenuItem Header="현재 줄 메모…" Tag="memo" Click="Action_Click"/>
            <MenuItem Header="대체 초안…" Tag="drafts" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="보기(_V)">
            <MenuItem x:Name="OriginalToggle" Header="원본 패널" IsCheckable="True" IsChecked="True" Click="OriginalToggle_Click"/>
            <MenuItem x:Name="SourceToggle" Header="텍스트 패널" IsCheckable="True" IsChecked="True" Click="PanelToggle_Click"/>
            <MenuItem x:Name="BrailleToggle" Header="점자 패널" IsCheckable="True" IsChecked="True" Click="PanelToggle_Click"/>
            <MenuItem x:Name="LineNumbersToggle" Header="줄 번호" IsCheckable="True" IsChecked="True" Click="LineNumbersToggle_Click"/>
            <MenuItem Header="점자 창 분리 / 합치기" Tag="detach" Click="Action_Click"/>
            <MenuItem Header="텍스트 창 분리 / 합치기" Tag="detachSource" Click="Action_Click"/>
            <MenuItem Header="원본 창 분리 / 합치기" Tag="detachOriginal" Click="Action_Click"/>
            <MenuItem x:Name="LinePreviewToggle" Header="줄번역" IsCheckable="True" IsChecked="True" Click="LinePreviewToggle_Click"/>
            <Separator/><MenuItem Header="글자 크게" Tag="zoomIn" Click="Action_Click"/><MenuItem Header="글자 작게" Tag="zoomOut" Click="Action_Click"/><MenuItem Header="글자 크기 초기화" Tag="zoomReset" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="삽입(_I)">
            <MenuItem Header="특수 기호…" Tag="symbol" Click="Action_Click"/>
            <MenuItem x:Name="AllTagsMenu" Header="점역 태그"/>
            <MenuItem Header="꼬리말…" Tag="footer" Click="Action_Click"/><MenuItem Header="강조" Tag="tag:강조" Click="Action_Click"/><MenuItem Header="점역자 주" Tag="tag:주" Click="Action_Click"/>
            <MenuItem Header="상자" Tag="tag:상자" Click="Action_Click"/>
            <MenuItem Header="상자 끝" Tag="tag:상자끝" Click="Action_Click"/>
            <MenuItem Header="쪽바꿈" Tag="tag:쪽바꿈" Click="Action_Click"/>
            <MenuItem Header="장바꿈" Tag="tag:장바꿈" Click="Action_Click"/>
            <Separator/><MenuItem Header="수식 입력창…" Tag="math" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="설정(_M)">
            <MenuItem Header="편집용 점자문서 페이지설정…" Tag="layout" Click="Action_Click"/><MenuItem Header="6점키 설정…" Tag="sixdot" Click="Action_Click"/>
            <MenuItem Header="기본 점역 옵션…" InputGestureText="Alt+G" Tag="defaults" Click="Action_Click"/>
            <MenuItem Header="점역 양식…" Tag="forms" Click="Action_Click"/>
            <MenuItem Header="작업 점역 옵션…" Tag="translationOptions" Click="Action_Click"/>
            <MenuItem Header="문단 모양…" InputGestureText="Alt+S" Tag="appearance" Click="Action_Click"/>
            <MenuItem Header="편집창 색상…" InputGestureText="Alt+C" Tag="colors" Click="Action_Click"/>
            <MenuItem Header="상용구…" Tag="snippets" Click="Action_Click"/>
            <MenuItem Header="문서 전체 재점역" Tag="translateAll" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="정보(_A)">
            <MenuItem Header="로그인…" Tag="login" Click="Action_Click"/>
            <MenuItem Header="로그아웃" Tag="logout" Click="Action_Click"/>
            <MenuItem Header="마이페이지…" Tag="usage" Click="Action_Click"/>
            <MenuItem Header="세모점 정보…" Tag="about" Click="Action_Click"/>
            <MenuItem Header="게시판…" Tag="board" Click="Action_Click"/>
            <MenuItem Header="알림…" Tag="notifications" Click="Action_Click"/>
            <MenuItem Header="버전 정보…" Tag="version" Click="Action_Click"/>
            <MenuItem Header="사용 안내" Tag="help" Click="Action_Click"/>
            <MenuItem x:Name="TimeoutToggle" Header="점역 응답 지연 체험" IsCheckable="True" Click="TimeoutToggle_Click"/>
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>
    <Border x:Name="EditorToolbar" DockPanel.Dock="Top" Height="40" Background="#FAFAFA" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="‹" Tag="previous" Click="Action_Click" Style="{StaticResource FormatButton}" ToolTip="이전 블록"/>
          <ComboBox x:Name="BlockPicker" Width="235" Height="26" MinHeight="26" FontSize="12" Padding="4,0" ItemsSource="{Binding Blocks}" DisplayMemberPath="Label" SelectedItem="{Binding ActiveBlock, Mode=OneWay}" SelectionChanged="BlockPicker_SelectionChanged" AutomationProperties.Name="작업 블록 선택"/>
          <Button Content="›" Tag="next" Click="Action_Click" Style="{StaticResource FormatButton}" ToolTip="다음 블록"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Tag="new" ToolTip="새 문서 (Ctrl+N)" AutomationProperties.Name="새 문서 (Ctrl+N)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.new}" IsHitTestVisible="False"/></Button>
          <Button Tag="open" ToolTip="열기 (Ctrl+O)" AutomationProperties.Name="열기 (Ctrl+O)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.open}" IsHitTestVisible="False"/></Button>
          <Button Tag="save" ToolTip="저장 (Ctrl+S)" AutomationProperties.Name="저장 (Ctrl+S)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.save}" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <Button Tag="cut" ToolTip="잘라내기 (Ctrl+X)" AutomationProperties.Name="잘라내기 (Ctrl+X)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox x:Name="CutIcon" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/cut.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="copy" ToolTip="복사 (Ctrl+C)" AutomationProperties.Name="복사 (Ctrl+C)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.copy}" IsHitTestVisible="False"/></Button>
          <Button Tag="paste" ToolTip="붙여넣기 (Ctrl+V)" AutomationProperties.Name="붙여넣기 (Ctrl+V)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.paste}" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <Button Tag="undo" ToolTip="되돌리기 (Ctrl+Z)" AutomationProperties.Name="되돌리기 (Ctrl+Z)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.undo}" IsHitTestVisible="False"/></Button>
          <Button Tag="redo" ToolTip="다시 실행 (Ctrl+Y)" AutomationProperties.Name="다시 실행 (Ctrl+Y)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.redo}" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <Button Tag="find" ToolTip="찾기 (Ctrl+F)" AutomationProperties.Name="찾기 (Ctrl+F)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.find}" IsHitTestVisible="False"/></Button>
          <Button Tag="goto" ToolTip="이동 (Ctrl+G)" AutomationProperties.Name="이동 (Ctrl+G)" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.goto}" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <Button Tag="export" ToolTip="문서 내보내기" AutomationProperties.Name="문서 내보내기" Click="Action_Click" Style="{StaticResource IconButton}"><ContentControl Content="{StaticResource Icon.export}" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <ComboBox x:Name="ZoomPicker" Width="92" Height="32" FontSize="12" SelectionChanged="ZoomPicker_SelectionChanged" AutomationProperties.Name="편집기 확대 비율"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Height="32" Background="#F3F3F3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="점역 옵션…" Tag="translationOptions" Click="Action_Click" Width="104" Height="24" MinHeight="24" Padding="4,0" FontSize="12"/>
        <Button x:Name="FontSizeLabel" Content="14 px" Tag="zoomReset" Click="Action_Click" ToolTip="기본 글자 크기로 복원" Width="66" Height="24" MinHeight="24" Padding="4,0" Margin="4,0" FontSize="12"/>
        <Border Background="#FAFAFA" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="7,0" Height="24"><TextBlock x:Name="OptionsLabel" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
<Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
        <Button Tag="tag:쪽바꿈" ToolTip="쪽바꿈" AutomationProperties.Name="쪽바꿈" Click="Action_Click" Style="{StaticResource FormatButton}"><ContentControl Content="{StaticResource Icon.pagebreak}" IsHitTestVisible="False"/></Button>
        <Button Tag="footer" ToolTip="꼬리말" AutomationProperties.Name="꼬리말" Click="Action_Click" Style="{StaticResource FormatButton}"><ContentControl Content="{StaticResource Icon.footer}" IsHitTestVisible="False"/></Button>
        <Button Tag="tag:가운데정렬" ToolTip="가운데 정렬" AutomationProperties.Name="가운데 정렬" Click="Action_Click" Style="{StaticResource FormatButton}"><ContentControl Content="{StaticResource Icon.align}" IsHitTestVisible="False"/></Button>
        <Button Tag="tag:강조" ToolTip="강조" AutomationProperties.Name="강조" Click="Action_Click" Style="{StaticResource FormatButton}"><ContentControl Content="{StaticResource Icon.emph}" IsHitTestVisible="False"/></Button>
        <Button Tag="tag:밑줄빈칸" ToolTip="밑줄 빈칸" AutomationProperties.Name="밑줄 빈칸" Click="Action_Click" Style="{StaticResource FormatButton}"><ContentControl Content="{StaticResource Icon.blank}" IsHitTestVisible="False"/></Button>
        <Button Tag="memo" ToolTip="현재 줄 메모" AutomationProperties.Name="현재 줄 메모" Click="Action_Click" Style="{StaticResource FormatButton}"><ContentControl Content="{StaticResource Icon.note}" IsHitTestVisible="False"/></Button>
        <Button Tag="math" ToolTip="수식" AutomationProperties.Name="수식" Click="Action_Click" Style="{StaticResource FormatButton}"><ContentControl Content="{StaticResource Icon.math}" IsHitTestVisible="False"/></Button>
        <Border Width="1" Height="16" Background="#B5B5B5" Margin="8,0"/>
        <CheckBox x:Name="SixDotToggle" Content="6점 입력" Margin="0,0,4,0" FontSize="12" Checked="SixDotToggle_Changed" Unchecked="SixDotToggle_Changed" ToolTip="설정한 여섯 키를 함께 누르고 놓으면 점자가 입력됩니다"/>
        <Button Content="키 설정" Tag="sixdot" Click="Action_Click" Style="{StaticResource FormatButton}" Width="56" FontSize="12" ToolTip="6점키 설정 (Alt+K)"/>
        <Border Width="1" Height="16" Background="#B5B5B5" Margin="8,0"/>
<Button Tag="drafts" ToolTip="표 점역 초안" AutomationProperties.Name="표 점역 초안" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox x:Name="DraftIcon" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/draft.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button><Button Tag="lineNumbers" ToolTip="줄 번호 켜기 / 끄기" AutomationProperties.Name="줄 번호 켜기 / 끄기" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox x:Name="LinenoIcon" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/lineno.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Content="판면" Tag="layout" Click="Action_Click" Style="{StaticResource FormatButton}" Width="44" FontSize="12"/>
        <Button Content="점역" Tag="translate" Click="Action_Click" Style="{StaticResource FormatButton}" Width="44" FontSize="12" ToolTip="현재 블록을 내장 엔진으로 점역"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Height="24" Background="#F3F3F3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="8,0">
      <DockPanel>
        <TextBlock x:Name="AccountLabel" DockPanel.Dock="Right" Text="로그인 안 됨" FontSize="11" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
        <TextBlock x:Name="CaretStatus" DockPanel.Dock="Left" FontSize="11" Margin="0,0,12,0"/>
        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
      </DockPanel>
    </Border>
    <TabControl x:Name="DocumentTabs" DockPanel.Dock="Top" Height="32" BorderThickness="0" Padding="0" SelectionChanged="DocumentTabs_SelectionChanged"/>
    <Border x:Name="SelectionPane" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FAFAFA" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="8">
      <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="SelectionHide_Click" Height="22" MinHeight="22" Padding="4,0"/><TextBlock x:Name="SelectionCaption" FontSize="12"/></DockPanel>
        <ListBox x:Name="BlockSelectionList" SelectionMode="Extended" Height="65" DisplayMemberPath="Label" PreviewMouseLeftButtonDown="BlockSelection_MouseDown" PreviewMouseMove="BlockSelection_MouseMove"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="삭제" Tag="deleteBlock" Click="Action_Click"/><Button Content="위로" Tag="moveBlockUp" Click="Action_Click"/><Button Content="아래로" Tag="moveBlockDown" Click="Action_Click"/><Button Content="들여쓰기" Tag="indent" Click="Action_Click"/><Button Content="내어쓰기" Tag="unindent" Click="Action_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <local:LineTranslation x:Name="LineStrip" DockPanel.Dock="Bottom"/>
    <Grid x:Name="PanelGrid" Margin="0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="OriginalColumn" Width="380*" MinWidth="260"/><ColumnDefinition x:Name="OriginalSplitterColumn" Width="1"/><ColumnDefinition Width="484*" MinWidth="300"/><ColumnDefinition Width="1"/><ColumnDefinition Width="576*" MinWidth="300"/></Grid.ColumnDefinitions>
      <Border x:Name="OriginalPanel" BorderBrush="{StaticResource Line}" BorderThickness="0" Background="White"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="OriginalHeader" Style="{StaticResource PanelHeader}"><DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock x:Name="OriginalPosition" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
            <Button Content="⧉" Tag="detachOriginal" Click="Action_Click" Style="{StaticResource PanelButton}" ToolTip="원본 창 분리 / 합치기"/>
            <Button Content="×" Tag="hideOriginal" Click="Action_Click" Style="{StaticResource PanelButton}" ToolTip="원본 패널 숨기기"/>
          </StackPanel>
          <Border DockPanel.Dock="Left" Style="{StaticResource PanelNumber}"><TextBlock Text="1" Foreground="White" FontSize="12" HorizontalAlignment="Center"/></Border>
          <TextBlock Text="원본 이미지" FontSize="12"/>
        </DockPanel></Border>
        <local:OriginalPreview x:Name="Original" Grid.Row="1"/>
        <Border Grid.Row="1" x:Name="OriginalEmpty" Visibility="Collapsed" Background="#F4F6F8"><Grid><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel><Viewbox Stretch="Uniform"><Grid x:Name="OriginalImageGrid" MouseLeftButtonDown="OriginalImage_MouseDown"><Image x:Name="OriginalImage" Stretch="Fill"/><Canvas><Rectangle x:Name="OriginalSelection" Stroke="#4D85C8" Fill="#205287C1" StrokeThickness="3" Visibility="Collapsed"/></Canvas></Grid></Viewbox><TextBlock x:Name="OriginalText" Text="원본 미리보기 없음" TextWrapping="Wrap" Margin="16"/></StackPanel></ScrollViewer></Grid></Border>
      </Grid></Border>
      <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext"/>
      <Border x:Name="SourcePanel" Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="0" Background="White">
        <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border x:Name="SourceHeader" Style="{StaticResource PanelHeader}"><DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock x:Name="SourcePosition" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
              <Button Content="⧉" Tag="detachSource" Click="Action_Click" Style="{StaticResource PanelButton}" ToolTip="텍스트 창 분리 / 합치기"/>
              <Button Content="×" Tag="hideSource" Click="Action_Click" Style="{StaticResource PanelButton}" ToolTip="텍스트 패널 숨기기"/>
            </StackPanel>
            <Border DockPanel.Dock="Left" Style="{StaticResource PanelNumber}"><TextBlock Text="2" Foreground="White" FontSize="12" HorizontalAlignment="Center"/></Border>
            <TextBlock Text="텍스트" FontSize="12"/>
          </DockPanel></Border>
          <ae:TextEditor Grid.Row="1" x:Name="SourceEditor" FontFamily="Malgun Gothic" FontSize="14" ShowLineNumbers="True" WordWrap="True" Padding="8,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="원문 텍스트 편집기"/>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" ResizeBehavior="PreviousAndNext"/>
      <Border x:Name="BrailleContainer" Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="0"><Grid>
        <local:BraillePane x:Name="Braille"/>
        <Border x:Name="DetachedPlaceholder" Visibility="Collapsed" Background="#F4F6F8"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="점자 창이 분리되어 있습니다" FontSize="17"/><TextBlock Text="독립 창에서도 같은 블록을 편집합니다." Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><Button Content="이 창으로 합치기" Tag="detach" Click="Action_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
      </Grid></Border>
    </Grid>
  </DockPanel>
</Window>
