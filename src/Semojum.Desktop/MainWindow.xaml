<Window x:Class="Semojum.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:svg="http://sharpvectors.codeplex.com/svgc/" xmlns:local="clr-namespace:Semojum.Desktop.Controls"
        Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Width="1440" Height="1000" MinWidth="480" MinHeight="360" WindowStartupLocation="CenterScreen" Closing="Window_Closing" UseLayoutRounding="True">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Controls/FinalMenuStyles.xaml"/></ResourceDictionary.MergedDictionaries><local:ToolbarHeightConverter x:Key="ToolbarHeightConverter"/></ResourceDictionary></Window.Resources>
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Height="32" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>

        <Menu x:Name="ApplicationMenu" Height="32" FontSize="12" Padding="0" Margin="4,0,0,0">
          <Menu.Resources><Style TargetType="MenuItem" BasedOn="{StaticResource FinalDesktopMenuItem}"/></Menu.Resources>
          <MenuItem Header="파일(_F)" Width="64">
            <MenuItem Header="새 문서" InputGestureText="Ctrl+N" Tag="new" Click="Action_Click"/>
            <MenuItem Header="열기" InputGestureText="Ctrl+O" Tag="open" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="저장" InputGestureText="Ctrl+S" Tag="save" Click="Action_Click"/>
            <MenuItem Header="다른 이름으로 저장" Tag="saveAs" Click="Action_Click"/>
            <MenuItem Header="범위 지정 저장" Tag="export" Click="Action_Click"/>
            <MenuItem x:Name="RecentFilesMenu" Visibility="Collapsed" Header="최근 문서" SubmenuOpened="RecentFiles_Opened"/>
          </MenuItem>
          <MenuItem Header="편집(_E)" Width="64">
            <MenuItem Header="되돌리기" InputGestureText="Ctrl+Z" Tag="undo" Click="Action_Click"/>
            <MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Tag="redo" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="잘라내기" InputGestureText="Ctrl+X" Tag="cut" Click="Action_Click"/>
            <MenuItem Header="복사" InputGestureText="Ctrl+C" Tag="copy" Click="Action_Click"/>
            <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Tag="paste" Click="Action_Click"/>
            <MenuItem Header="전체 선택" InputGestureText="Ctrl+A" Tag="selectAll" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="찾기 · 바꾸기" InputGestureText="Ctrl+F" Tag="find" Click="Action_Click"/>
            <MenuItem Header="이동" InputGestureText="Ctrl+G" Tag="goto" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="보기(_V)" Width="64">
            <MenuItem Header="글자 크기">
              <MenuItem Header="작게" Tag="zoomOut" Click="Action_Click" Style="{StaticResource FinalDesktopNestedItem}"/>
              <MenuItem Header="보통" Tag="zoomReset" Click="Action_Click" Style="{StaticResource FinalDesktopNestedItem}"/>
              <MenuItem Header="크게" Tag="zoomIn" Click="Action_Click" Style="{StaticResource FinalDesktopNestedItem}"/>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="FormattingToggle" Header="조판부호" IsCheckable="True" Tag="formatMarks" Click="Action_Click"/>
            <MenuItem x:Name="OutlineToggle" Header="쪽 분리 윤곽선" IsCheckable="True" IsChecked="True" Tag="showOutlines" Click="Action_Click"/>
            <MenuItem x:Name="LineNumbersToggle" Header="줄 번호" IsCheckable="True" IsChecked="True" Click="LineNumbersToggle_Click"/>
            <Separator/>
            <MenuItem x:Name="ToolbarToggle" Header="도구 모음" IsCheckable="True" IsChecked="True" Tag="showToolbar" Click="Action_Click"/>
            <MenuItem x:Name="StatusToggle" Header="상태 표시줄" IsCheckable="True" IsChecked="True" Tag="showStatus" Click="Action_Click"/>
            <MenuItem x:Name="LinePreviewToggle" Header="줄번역" IsCheckable="True" IsChecked="True" Click="LinePreviewToggle_Click"/>
            <MenuItem x:Name="MemoToggle" Header="메모 표시" IsCheckable="True" IsChecked="True" Tag="showMemos" Click="Action_Click"/>
            <MenuItem x:Name="ReviewToggle" Header="검토 표시" IsCheckable="True" IsChecked="True" Tag="showReviews" Click="Action_Click"/>
            <Separator/>
            <MenuItem x:Name="OriginalToggle" Header="원본 패널" IsCheckable="True" IsChecked="True" Click="OriginalToggle_Click"/>
            <MenuItem x:Name="SourceToggle" Header="텍스트 패널" IsCheckable="True" IsChecked="True" Click="PanelToggle_Click"/>
            <MenuItem x:Name="BrailleToggle" Header="점자 패널" IsCheckable="True" IsChecked="True" Click="PanelToggle_Click"/>
            <MenuItem Header="패널 모두 제자리로" Tag="restorePanels" Click="Action_Click"/>
          </MenuItem>
          <MenuItem x:Name="AllTagsMenu" Header="삽입(_I)" Width="64">
            <MenuItem Header="꼬리말..." Tag="footerInsert" Click="Action_Click"/>
            <MenuItem Header="꼬리말 관리..." Tag="footer" Click="Action_Click"/>
            <MenuItem Header="수식 입력창" Tag="math" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="설정(_M)" Width="64">
            <MenuItem Header="편집용 점자문서 페이지설정" InputGestureText="Alt+Y" Tag="layout" Click="Action_Click"/>
            <MenuItem Header="기본 점역 옵션 설정" InputGestureText="Alt+G" Tag="defaults" Click="Action_Click"/>
            <MenuItem Header="점역 양식" Tag="forms" Click="Action_Click"/>
            <MenuItem Header="6점키 설정" InputGestureText="Alt+K" Tag="sixdot" Click="Action_Click"/>
            <MenuItem Header="시각 자료 설명 유형" Tag="visualDescriptions" Click="Action_Click"/>
            <Separator/>
            <MenuItem x:Name="AutoUpdateToggle" Header="업데이트 자동 확인" IsCheckable="True" IsChecked="True" Tag="autoUpdate" Click="Action_Click"/>
            <MenuItem x:Name="SixDotToggle" Visibility="Collapsed" Header="6점 입력" IsCheckable="True" Checked="SixDotToggle_Changed" Unchecked="SixDotToggle_Changed"/>
          </MenuItem>
          <MenuItem Header="정보(_A)" Width="64">
            <MenuItem Header="도움말" InputGestureText="F1" Tag="help" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="마이페이지 · 사용량" Tag="usage" Click="Action_Click"/>
            <Separator/>
            <MenuItem Header="게시판" Tag="board" Click="Action_Click"/>
            <MenuItem Header="문의하기" Tag="inquiry" Click="Action_Click"/>
            <MenuItem Header="세모점 정보" Tag="about" Click="Action_Click"/>
            <MenuItem x:Name="TimeoutToggle" Visibility="Collapsed" Header="점역 응답 지연 체험" IsCheckable="True" Click="TimeoutToggle_Click"/>
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>
    <Border x:Name="EditorToolbar" DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0">
      <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="{Binding ComputedHorizontalScrollBarVisibility, ElementName=EditorToolbarScroll, Converter={StaticResource ToolbarHeightConverter}, ConverterParameter=40}"/></Style></Border.Style>
      <ScrollViewer x:Name="EditorToolbarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="기본 도구 모음 가로 스크롤">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border BorderBrush="#B5B5B5" BorderThickness="1" Background="White" Width="240" Height="32" Margin="8,0,4,0" Padding="7,0">
            <DockPanel><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/common-rulebook.svg" Width="16" Height="16" Stretch="None" Margin="0,0,8,0" IsHitTestVisible="False"/><Grid><TextBox x:Name="RuleSearch" Height="30" MinHeight="30" Padding="0" FontSize="12" BorderThickness="0" MaxLength="100" ToolTip="점자 규정 검색 · Enter" AutomationProperties.Name="점자 규정 검색" KeyDown="RuleSearch_KeyDown"/>
            <TextBlock Text="점역 규정 검색..." FontSize="12" Foreground="#767676" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RuleSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
          </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
          <Button Content="‹" Tag="previous" Click="Action_Click" Style="{StaticResource FormatButton}" ToolTip="이전 블록"/>
          <ComboBox x:Name="BlockPicker" Width="150" Height="26" MinHeight="26" FontSize="12" Padding="4,0" ItemsSource="{Binding Blocks}" DisplayMemberPath="Label" SelectedItem="{Binding ActiveBlock, Mode=OneWay}" SelectionChanged="BlockPicker_SelectionChanged" AutomationProperties.Name="작업 블록 선택"/>
          <Button Content="›" Tag="next" Click="Action_Click" Style="{StaticResource FormatButton}" ToolTip="다음 블록"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Tag="new" ToolTip="새 문서 (Ctrl+N)" AutomationProperties.Name="새 문서 (Ctrl+N)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-new.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="open" ToolTip="열기 (Ctrl+O)" AutomationProperties.Name="열기 (Ctrl+O)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-open.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="save" ToolTip="저장 (Ctrl+S)" AutomationProperties.Name="저장 (Ctrl+S)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-save.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <Button Tag="cut" ToolTip="잘라내기 (Ctrl+X)" AutomationProperties.Name="잘라내기 (Ctrl+X)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox x:Name="CutIcon" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-cut.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="copy" ToolTip="복사 (Ctrl+C)" AutomationProperties.Name="복사 (Ctrl+C)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-copy.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="paste" ToolTip="붙여넣기 (Ctrl+V)" AutomationProperties.Name="붙여넣기 (Ctrl+V)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-paste.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <Button Tag="undo" ToolTip="되돌리기 (Ctrl+Z)" AutomationProperties.Name="되돌리기 (Ctrl+Z)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-undo.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="redo" ToolTip="다시 실행 (Ctrl+Y)" AutomationProperties.Name="다시 실행 (Ctrl+Y)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-redo.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <Button Tag="find" ToolTip="찾기 (Ctrl+F)" AutomationProperties.Name="찾기 (Ctrl+F)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-find.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="goto" ToolTip="이동 (Ctrl+G)" AutomationProperties.Name="이동 (Ctrl+G)" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-goto.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
          <Button Tag="translate" ToolTip="현재 블록 다시 점역" AutomationProperties.Name="현재 블록 다시 점역" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-recon.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <Button Tag="export" ToolTip="문서 내보내기" AutomationProperties.Name="문서 내보내기" Click="Action_Click" Style="{StaticResource IconButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-export.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          <ComboBox x:Name="ZoomPicker" Visibility="Collapsed" Width="92" Height="32" FontSize="12" SelectionChanged="ZoomPicker_SelectionChanged" AutomationProperties.Name="편집기 확대 비율"/>
        </StackPanel>
      </DockPanel>
      </ScrollViewer>
    </Border>
    <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0">
      <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="{Binding ComputedHorizontalScrollBarVisibility, ElementName=FormatToolbarScroll, Converter={StaticResource ToolbarHeightConverter}, ConverterParameter=32}"/></Style></Border.Style>
      <ScrollViewer x:Name="FormatToolbarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="서식 도구 모음 가로 스크롤">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ComboBox x:Name="TextStylePicker" Width="104" Height="24" MinHeight="24" FontSize="12" SelectedIndex="0" SelectionChanged="TextStylePicker_SelectionChanged" AutomationProperties.Name="텍스트 서식"><ComboBoxItem Content="본문"/><ComboBoxItem Content="강조"/><ComboBoxItem Content="굵은"/><ComboBoxItem Content="색강조"/><ComboBoxItem Content="취소선"/></ComboBox>
        <ComboBox x:Name="FontSizeLabel" ToolTip="텍스트 글자 크기" Width="66" Height="24" MinHeight="24" Margin="4,0" FontSize="12" SelectionChanged="FontSizePicker_SelectionChanged"><ComboBoxItem Content="12"/><ComboBoxItem Content="14" IsSelected="True"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/><ComboBoxItem Content="30"/><ComboBoxItem Content="32"/></ComboBox>
        <Border Background="#FAFAFA" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="7,0" Height="24" Width="154"><TextBlock x:Name="OptionsLabel" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
<Border Width="1" Height="20" Background="#B5B5B5" Margin="8,0"/>
        <Button Tag="tag:쪽바꿈" ToolTip="쪽바꿈" AutomationProperties.Name="쪽바꿈" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-pagebreak.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Tag="footer" ToolTip="꼬리말" AutomationProperties.Name="꼬리말" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-footer.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Tag="tag:가운데정렬" ToolTip="가운데 정렬" AutomationProperties.Name="가운데 정렬" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-align.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Tag="tag:강조" ToolTip="강조" AutomationProperties.Name="강조" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-emph.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Tag="tag:밑줄빈칸" ToolTip="밑줄 빈칸" AutomationProperties.Name="밑줄 빈칸" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-blank.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Tag="table" ToolTip="표 편집" AutomationProperties.Name="표 편집" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-table.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Tag="memo" ToolTip="현재 줄 메모" AutomationProperties.Name="현재 줄 메모" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-note.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Tag="math" ToolTip="수식" AutomationProperties.Name="수식" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-math.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Border Width="1" Height="16" Background="#B5B5B5" Margin="4,0,8,0"/>
        <ComboBox x:Name="IndentPicker" Width="74" Height="24" MinHeight="24" FontSize="12" SelectedIndex="2" SelectionChanged="IndentPicker_SelectionChanged" ToolTip="선택한 줄 들여쓰기"><ComboBoxItem Content="1칸"/><ComboBoxItem Content="2칸"/><ComboBoxItem Content="3칸"/><ComboBoxItem Content="4칸"/></ComboBox>
        <Border Width="1" Height="16" Background="#B5B5B5" Margin="8,0"/>
<Button Tag="drafts" ToolTip="표 점역 초안" AutomationProperties.Name="표 점역 초안" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox x:Name="DraftIcon" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-draft.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Border Width="1" Height="16" Background="#B5B5B5" Margin="4,0,8,0"/>
        <Button Tag="formatMarks" ToolTip="편집 부호 표시" AutomationProperties.Name="편집 부호 표시" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-mark.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button Tag="lineNumbers" ToolTip="줄 번호 켜기 / 끄기" AutomationProperties.Name="줄 번호 켜기 / 끄기" Click="Action_Click" Style="{StaticResource FormatButton}"><svg:SvgViewbox x:Name="LinenoIcon" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/main-toolbar-lineno.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
      </StackPanel>
      </ScrollViewer>
    </Border>
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="28" Background="#F3F3F3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel x:Name="StatusZoom" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
          <Button Width="16" Height="20" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="축소" AutomationProperties.Name="축소" Tag="zoomOut" Click="Action_Click"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/zoom-minus.svg" Width="16" Height="16" IsHitTestVisible="False"/></Button>
          <Slider x:Name="ZoomSlider" Width="106" Height="20" Margin="6,0" Minimum="0" Maximum="100" Value="50" SmallChange="1" LargeChange="5" ValueChanged="ZoomSlider_ValueChanged" AutomationProperties.Name="편집기 확대 비율">
            <Slider.Template><ControlTemplate TargetType="Slider"><Grid><Border Height="4" CornerRadius="2" Background="#D1D1D1"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#005FB8"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Slider.Template>
          </Slider>
          <Button Width="16" Height="20" Padding="0" BorderThickness="0" Background="Transparent" ToolTip="확대" AutomationProperties.Name="확대" Tag="zoomIn" Click="Action_Click"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/zoom-plus.svg" Width="16" Height="16" IsHitTestVisible="False"/></Button>
          <TextBlock x:Name="ZoomPercent" Width="40" Margin="8,0,0,0" Text="100%" FontSize="12" Foreground="#5F5F5F" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="AccountLabel" DockPanel.Dock="Right" Text="로그인 안 됨" FontSize="12" Foreground="{StaticResource Muted}" Margin="12,0,12,0"/>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" TextElement.FontSize="12">
          <Border Width="88" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="8,0"><TextBlock x:Name="StatusInput"/></Border>
          <Border Width="97" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,0"><TextBlock x:Name="StatusPage" TextTrimming="CharacterEllipsis"/></Border>
          <Border Width="51" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,0"><TextBlock x:Name="CaretStatus"/></Border>
          <Border Width="90" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,0"><TextBlock x:Name="StatusCell"/></Border>
          <Border Width="174" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="12,0"><TextBlock x:Name="StatusOptions" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/></Border>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Border>
    <TabControl x:Name="DocumentTabs" DockPanel.Dock="Top" Height="34" BorderThickness="0" Padding="0" Background="#F9F9F9" SelectionChanged="DocumentTabs_SelectionChanged">
      <TabControl.Resources>
        <Style TargetType="{x:Type TabItem}">
          <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="6,0"/>
          <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#5F5F5F"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Grid Background="{TemplateBinding Background}">
              <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
              <Border x:Name="ActiveLine" Height="2" Background="#005FB8" VerticalAlignment="Top" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ActiveLine" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
          <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#1A1A1A"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="14"/></Trigger></Style.Triggers>
        </Style>
      </TabControl.Resources>
    </TabControl>
    <Border x:Name="ConversionBanner" DockPanel.Dock="Top" Width="420" Height="160" HorizontalAlignment="Center" Background="White" BorderBrush="#B5B5B5" BorderThickness="1" Visibility="Collapsed">
      <Canvas>
        <ProgressBar Canvas.Left="15" Canvas.Top="39" Width="388" Height="8" Minimum="0" Maximum="{Binding Progress.Total, Mode=OneWay}" Value="{Binding Progress.Finished, Mode=OneWay}" Style="{StaticResource FlatUsageBar}" AutomationProperties.Name="문서 변환 진행률"/>
        <TextBlock Canvas.Left="15" Canvas.Top="55" Width="388" Text="{Binding Progress.CompactLabel}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Progress.Label}"/>
        <Button Canvas.Left="15" Canvas.Top="87" Content="취소" Tag="cancelJob" Click="Action_Click" Width="76" Height="24" MinHeight="24" Padding="0" FontSize="12" ToolTip="이미 처리한 쪽은 보존하고 남은 변환을 중단합니다."/>
      </Canvas>
    </Border>
    <Border x:Name="OperationErrorBanner" DockPanel.Dock="Top" Padding="12,8" Background="#FFF4D6">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ErrorNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="닫기" Click="ErrorNotice_Close" Margin="12,0,0,0"/>
        <Button x:Name="ReviewPendingServerPages" DockPanel.Dock="Right" Content="재개 결과 확인" Click="ReviewPendingServerPages_Click" Margin="12,0,0,0">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingServerPages}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button x:Name="CheckPendingRestart" DockPanel.Dock="Right" Content="재개 상태 확인" Click="CheckPendingRestart_Click" Margin="12,0,0,0">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingRestart}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <TextBlock Text="{Binding ErrorNotice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
      </DockPanel>
    </Border>
    <Border x:Name="CreditBanner" DockPanel.Dock="Top" Height="32" Background="#FFF4CE" BorderBrush="#9D5D00" BorderThickness="1">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding CreditNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel>
        <Button DockPanel.Dock="Right" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" Margin="5,0,3,0" Background="Transparent" BorderBrush="Transparent" Click="CreditNotice_Close" AutomationProperties.Name="크레딧 안내 닫기"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/credit-banner-close.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
        <Button DockPanel.Dock="Right" Content="이어서 처리" Width="110" Height="30" MinHeight="30" Padding="0" FontSize="12" Style="{StaticResource PrimaryButton}" Click="CreditResume_Click" ToolTip="크레딧을 충전한 뒤 멈춘 쪽만 다시 처리합니다. 처리된 쪽은 그대로 편집할 수 있습니다."/>
        <svg:SvgViewbox DockPanel.Dock="Left" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/credit-banner-warning.svg" Width="16" Height="16" Stretch="None" Margin="11,0,4,0"/>
        <TextBlock Text="{Binding CreditNotice}" FontSize="14" FontWeight="Bold" Foreground="#9D5D00" TextTrimming="CharacterEllipsis" ToolTip="{Binding CreditNotice}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
      </DockPanel>
    </Border>
    <Border x:Name="SelectionPane" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FAFAFA" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="8">
      <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="SelectionHide_Click" Height="22" MinHeight="22" Padding="4,0"/><TextBlock x:Name="SelectionCaption" FontSize="12"/></DockPanel>
        <ListBox x:Name="BlockSelectionList" SelectionMode="Extended" Height="65" DisplayMemberPath="Label" PreviewMouseLeftButtonDown="BlockSelection_MouseDown" PreviewMouseMove="BlockSelection_MouseMove"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="삭제" Tag="deleteBlock" Click="Action_Click"/><Button Content="위로" Tag="moveBlockUp" Click="Action_Click"/><Button Content="아래로" Tag="moveBlockDown" Click="Action_Click"/><Button Content="들여쓰기" Tag="indent" Click="Action_Click"/><Button Content="내어쓰기" Tag="unindent" Click="Action_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <local:LineTranslation x:Name="LineStrip" DockPanel.Dock="Bottom"/>
    <Grid>
    <ScrollViewer x:Name="PanelScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="편집 패널 가로 스크롤">
    <Grid x:Name="PanelGrid" Margin="0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="OriginalColumn" Width="379*" MinWidth="260"/><ColumnDefinition x:Name="OriginalSplitterColumn" Width="1"/><ColumnDefinition Width="483*" MinWidth="300"/><ColumnDefinition Width="1"/><ColumnDefinition Width="576*" MinWidth="300"/></Grid.ColumnDefinitions>
      <Border x:Name="OriginalPanel" BorderBrush="{StaticResource Line}" BorderThickness="0" Background="White"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="OriginalHeader" Background="#F9F9F9" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="12,0,8,0"><DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <TextBlock x:Name="OriginalPosition" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
            <Button Content="⧉" Tag="detachOriginal" Click="Action_Click" Style="{StaticResource IconButton}" ToolTip="원본 창 분리 / 합치기" AutomationProperties.Name="원본 창 분리 또는 합치기"/>
            <Button Tag="hideOriginal" Click="Action_Click" Style="{StaticResource IconButton}" ToolTip="원본 패널 숨기기" AutomationProperties.Name="원본 패널 숨기기"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/panel-original-close.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="OriginalPanelTitle" Text="원본" FontSize="14" Foreground="#5F5F5F" VerticalAlignment="Center"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#EAEAEA" Margin="8,0,0,0"><TextBlock Text="1" Foreground="#5F5F5F" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
        </DockPanel></Border>
        <local:OriginalPreview x:Name="Original" Grid.Row="1"/>
        <Border Grid.Row="1" x:Name="OriginalEmpty" Visibility="Collapsed" Background="#F4F6F8"><Grid><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel><Viewbox Stretch="Uniform"><Grid x:Name="OriginalImageGrid" MouseLeftButtonDown="OriginalImage_MouseDown"><Image x:Name="OriginalImage" Stretch="Fill"/><Canvas><Rectangle x:Name="OriginalSelection" Stroke="#D5AC00" Fill="#60FFF5A3" StrokeThickness="3" Visibility="Collapsed"/></Canvas></Grid></Viewbox><TextBlock x:Name="OriginalText" Text="원본 미리보기 없음" TextWrapping="Wrap" Margin="16"/></StackPanel></ScrollViewer></Grid></Border>
        <local:PanelPageBar x:Name="OriginalPageBar" Grid.Row="2" Loaded="OriginalPageBar_Loaded"/>
      </Grid></Border>
      <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext"/>
      <Border x:Name="SourcePanel" Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="0" Background="White">
        <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="SourceHeader" Background="#F9F9F9" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="12,0,8,0"><DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock x:Name="SourcePosition" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
              <Button Content="⧉" Tag="detachSource" Click="Action_Click" Style="{StaticResource IconButton}" ToolTip="텍스트 창 분리 / 합치기" AutomationProperties.Name="텍스트 창 분리 또는 합치기"/>
              <Button Tag="hideSource" Click="Action_Click" Style="{StaticResource IconButton}" ToolTip="텍스트 패널 숨기기" AutomationProperties.Name="텍스트 패널 숨기기"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/panel-source-close.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:Name="SourcePanelTitle" Text="텍스트" FontSize="14" Foreground="#5F5F5F" VerticalAlignment="Center"/>
              <Border Width="18" Height="18" CornerRadius="9" Background="#EAEAEA" Margin="8,0,0,0"><TextBlock x:Name="SourcePanelNumber" Text="2" Foreground="#5F5F5F" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel>
          </DockPanel></Border>
          <local:ContinuousSourceEditor Grid.Row="1" x:Name="PageEditor" Visibility="Collapsed"/>
          <ae:TextEditor Grid.Row="1" x:Name="SourceEditor" FontFamily="Malgun Gothic" FontSize="14" ShowLineNumbers="True" WordWrap="True" Padding="8,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="원문 텍스트 편집기"/>
          <local:MathPreviewDock Grid.Row="2" x:Name="MathDock" Visibility="Collapsed"/>
          <local:PanelPageBar x:Name="SourcePageBar" Grid.Row="3" Loaded="SourcePageBar_Loaded"/>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" ResizeBehavior="PreviousAndNext"/>
      <Border x:Name="BrailleContainer" Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="0"><Grid>
        <local:BraillePane x:Name="Braille"/>
        <Border x:Name="DetachedPlaceholder" Visibility="Collapsed" Background="#F4F6F8"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="점자 창이 분리되어 있습니다" FontSize="17"/><TextBlock Text="독립 창에서도 같은 블록을 편집합니다." Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><Button Content="이 창으로 합치기" Tag="detach" Click="Action_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
      </Grid></Border>
      <Border x:Name="DraftDock" Grid.Column="2" Grid.ColumnSpan="3" Panel.ZIndex="10" VerticalAlignment="Bottom" Height="212"
              Visibility="Collapsed" Background="White" BorderBrush="#D1D1D1" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="#F3F3F3" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
            <DockPanel Margin="11,0,11,0">
              <Button x:Name="DraftDockClose" DockPanel.Dock="Right" Click="DraftDockClose_Click" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource PanelButton}" ToolTip="선택한 초안 적용하고 닫기" AutomationProperties.Name="선택한 초안 적용하고 닫기"><svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/draft-dock-close.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/></Button>
              <svg:SvgViewbox DockPanel.Dock="Left" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/draft-dock-icon.svg" Width="16" Height="16" Stretch="None" Margin="0,0,4,0"/>
              <TextBlock x:Name="DraftDockTitle" FontFamily="Malgun Gothic" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,32,0"><UniformGrid x:Name="DraftChoiceGrid" Columns="4"/></ScrollViewer>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DraftTextColumn"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="#D1D1D1" BorderThickness="0,0,1,0" Padding="15,8,8,4">
              <DockPanel><TextBlock DockPanel.Dock="Top" Text="묵자" FontFamily="Malgun Gothic" FontSize="12" Foreground="#5F5F5F"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="DraftTextPreview" FontFamily="Malgun Gothic" FontSize="12" LineHeight="20" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="선택한 초안 묵자 미리보기"/></ScrollViewer></DockPanel>
            </Border>
            <Border Grid.Column="1" Padding="15,8,8,4">
              <DockPanel><TextBlock DockPanel.Dock="Top" Text="점자" FontFamily="Malgun Gothic" FontSize="12" Foreground="#5F5F5F"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="DraftBraillePreview" FontFamily="Segoe UI Symbol" FontSize="22" LineHeight="28" TextWrapping="Wrap" VerticalAlignment="Top" AutomationProperties.Name="선택한 초안 점자 미리보기"/></ScrollViewer></DockPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
    </ScrollViewer>
    <Border x:Name="Welcome" Background="White" Visibility="Collapsed">
      <Border x:Name="WelcomeCard" Width="420" Height="260" BorderBrush="#B5B5B5" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Canvas>
          <Border Canvas.Left="15" Canvas.Top="15" Width="388" Height="180" Background="#FAFAFA" BorderBrush="#D6D6D6" BorderThickness="1">
            <TextBlock Text="작업 파일 없음" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Button Canvas.Left="149" Canvas.Top="211" Width="120" Height="24" MinHeight="24" Padding="0" FontSize="12" Content="파일 업로드" Tag="upload" Click="Action_Click" Style="{StaticResource PrimaryButton}"/>
        </Canvas>
      </Border>
    </Border>
    </Grid>
  </DockPanel>
</Window>
