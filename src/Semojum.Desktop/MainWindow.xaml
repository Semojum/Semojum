<Window x:Class="Semojum.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:local="clr-namespace:Semojum.Desktop.Controls"
        Style="{StaticResource {x:Type Window}}" Title="{Binding WindowTitle}" Width="1440" Height="1000" MinWidth="1280" MinHeight="800" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>
        <Border DockPanel.Dock="Right" Background="#E5EDF7" Padding="10,2" Margin="5"><TextBlock x:Name="AccountLabel" Text="로그인 안 됨" FontSize="11" Foreground="{StaticResource Accent}"/></Border>
        <Menu>
          <MenuItem Header="파일(_F)">
            <MenuItem Header="새 문서" InputGestureText="Ctrl+N" Tag="new" Click="Action_Click"/>
            <MenuItem Header="열기…" InputGestureText="Ctrl+O" Tag="open" Click="Action_Click"/>
            <MenuItem x:Name="RecentFilesMenu" Header="최근 문서" SubmenuOpened="RecentFiles_Opened"><MenuItem Header="최근 작업 파일이 없습니다" IsEnabled="False"/></MenuItem>
            <MenuItem Header="작업 폴더 선택…" Tag="workFolder" Click="Action_Click"/>
            <MenuItem Header="마지막 작업 폴더 열기…" Tag="lastFolder" Click="Action_Click"/>
            <MenuItem Header="문서 업로드·AI 변환…" Tag="upload" Click="Action_Click"/>
            <MenuItem Header="서버 작업 열기…" Tag="serverOpen" Click="Action_Click"/>
            <MenuItem Header="현재 작업 변환 중단" Tag="cancelJob" Click="Action_Click"/>
            <Separator/><MenuItem Header="저장" InputGestureText="Ctrl+S" Tag="save" Click="Action_Click"/>
            <MenuItem Header="다른 이름으로 저장…" Tag="saveAs" Click="Action_Click"/>
            <MenuItem Header="문서 내보내기…" Tag="export" Click="Action_Click"/>
            <Separator/><MenuItem Header="샘플 문서 다시 열기" Tag="sample" Click="Action_Click"/>
            <MenuItem Header="닫기" Tag="close" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="편집(_E)">
            <MenuItem Header="되돌리기" InputGestureText="Ctrl+Z" Tag="undo" Click="Action_Click"/><MenuItem Header="다시 실행" InputGestureText="Ctrl+Y" Tag="redo" Click="Action_Click"/>
            <Separator/><MenuItem Header="잘라내기" Tag="cut" Click="Action_Click"/><MenuItem Header="복사" Tag="copy" Click="Action_Click"/><MenuItem Header="붙여넣기" Tag="paste" Click="Action_Click"/>
            <Separator/><MenuItem Header="찾아 바꾸기…" InputGestureText="Ctrl+F" Tag="find" Click="Action_Click"/>
            <MenuItem Header="현재 줄 메모…" Tag="memo" Click="Action_Click"/>
            <MenuItem Header="표 점역 초안…" Tag="drafts" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="보기(_V)">
            <MenuItem x:Name="OriginalToggle" Header="원본 패널" IsCheckable="True" IsChecked="True" Click="OriginalToggle_Click"/>
            <MenuItem Header="점자 창 분리 / 합치기" Tag="detach" Click="Action_Click"/>
            <MenuItem x:Name="LinePreviewToggle" Header="줄번역" IsCheckable="True" IsChecked="True" Click="LinePreviewToggle_Click"/>
            <Separator/><MenuItem Header="글자 크게" Tag="zoomIn" Click="Action_Click"/><MenuItem Header="글자 작게" Tag="zoomOut" Click="Action_Click"/><MenuItem Header="글자 크기 초기화" Tag="zoomReset" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="삽입(_I)">
            <MenuItem Header="꼬리말…" Tag="footer" Click="Action_Click"/><MenuItem Header="강조" Tag="tag:강조" Click="Action_Click"/><MenuItem Header="점역자 주" Tag="tag:주" Click="Action_Click"/>
            <MenuItem Header="상자" Tag="tag:상자" Click="Action_Click"/>
            <MenuItem Header="상자 끝" Tag="tag:상자끝" Click="Action_Click"/>
            <MenuItem Header="쪽바꿈" Tag="tag:쪽바꿈" Click="Action_Click"/>
            <MenuItem Header="장바꿈" Tag="tag:장바꿈" Click="Action_Click"/>
            <Separator/><MenuItem Header="수식 입력창…" Tag="math" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="설정(_M)">
            <MenuItem Header="편집용 점자문서 페이지설정…" Tag="layout" Click="Action_Click"/><MenuItem Header="6점키 설정…" Tag="sixdot" Click="Action_Click"/>
            <MenuItem Header="작업 점역 옵션…" Tag="translationOptions" Click="Action_Click"/>
            <MenuItem Header="문서 전체 재점역" Tag="translateAll" Click="Action_Click"/>
          </MenuItem>
          <MenuItem Header="정보(_A)">
            <MenuItem Header="로그인…" Tag="login" Click="Action_Click"/>
            <MenuItem Header="로그아웃" Tag="logout" Click="Action_Click"/>
            <MenuItem Header="사용 안내" Tag="help" Click="Action_Click"/>
            <MenuItem x:Name="TimeoutToggle" Header="점역 응답 지연 체험" IsCheckable="True" Click="TimeoutToggle_Click"/>
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,5">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="점역 미리보기" Tag="translate" Click="Action_Click" Style="{StaticResource PrimaryButton}" Padding="15,5"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="＋" ToolTip="새 문서 (Ctrl+N)" Tag="new" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Button Content="열기" Tag="open" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Button Content="저장" Tag="save" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Separator Margin="8,2"/>
          <Button Content="↶" ToolTip="되돌리기" Tag="undo" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Button Content="↷" ToolTip="다시 실행" Tag="redo" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Separator Margin="8,2"/>
          <Button Content="강조" Tag="tag:강조" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Button Content="점역자 주" Tag="tag:주" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Button Content="메모" Tag="memo" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Button Content="수식" Tag="math" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <Separator Margin="8,2"/>
          <CheckBox x:Name="SixDotToggle" Content="6점 입력" Checked="SixDotToggle_Changed" Unchecked="SixDotToggle_Changed" ToolTip="F D S J K L을 함께 누른 뒤 놓아 점자 입력"/>
          <Button Content="판면 설정" Tag="layout" Click="Action_Click" Style="{StaticResource ToolButton}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Background="#F3F4F6" Padding="12,7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="텍스트 크기" Foreground="{StaticResource Muted}" Margin="8,0"/>
          <Button Content="−" Tag="zoomOut" Click="Action_Click" Style="{StaticResource ToolButton}"/>
          <TextBlock x:Name="FontSizeLabel" Text="18" Width="28" TextAlignment="Center"/>
          <Button Content="＋" Tag="zoomIn" Click="Action_Click" Style="{StaticResource ToolButton}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="작업 블록" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
          <Button Content="‹" Tag="previous" Click="Action_Click" Style="{StaticResource ToolButton}" ToolTip="이전 블록"/>
          <ComboBox x:Name="BlockPicker" Width="300" ItemsSource="{Binding Blocks}" DisplayMemberPath="Label" SelectedItem="{Binding ActiveBlock, Mode=OneWay}" SelectionChanged="BlockPicker_SelectionChanged" AutomationProperties.Name="작업 블록 선택"/>
          <Button Content="›" Tag="next" Click="Action_Click" Style="{StaticResource ToolButton}" ToolTip="다음 블록"/>
          <TextBlock Text="원본 · 텍스트 · 점자 함께 이동" Foreground="{StaticResource Muted}" FontSize="11" Margin="12,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#F1F3F5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,7">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="Ctrl+S 저장  |  자동 저장 없음" Foreground="{StaticResource Muted}" FontSize="11"/>
        <TextBlock Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Grid Margin="8,8,8,6">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="OriginalColumn" Width="0.82*" MinWidth="260"/><ColumnDefinition x:Name="OriginalSplitterColumn" Width="6"/><ColumnDefinition Width="*" MinWidth="340"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="340"/></Grid.ColumnDefinitions>
      <Border x:Name="OriginalPanel" BorderBrush="{StaticResource Line}" BorderThickness="1"><Grid>
        <local:OriginalPreview x:Name="Original"/>
        <Border x:Name="OriginalEmpty" Visibility="Collapsed" Background="#F4F6F8"><Grid><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel><Viewbox Stretch="Uniform"><Grid x:Name="OriginalImageGrid"><Image x:Name="OriginalImage" Stretch="Fill"/><Canvas><Rectangle x:Name="OriginalSelection" Stroke="#4D85C8" Fill="#205287C1" StrokeThickness="3" Visibility="Collapsed"/></Canvas></Grid></Viewbox><TextBlock x:Name="OriginalText" Text="원본 미리보기 없음" TextWrapping="Wrap" Margin="16"/></StackPanel></ScrollViewer></Grid></Border>
      </Grid></Border>
      <GridSplitter Grid.Column="1" ResizeBehavior="PreviousAndNext"/>
      <Border Grid.Column="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
        <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
          <Border Style="{StaticResource PanelHeader}"><DockPanel><TextBlock x:Name="SourcePosition" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="❷  텍스트" FontWeight="SemiBold"/></DockPanel></Border>
          <ae:TextEditor Grid.Row="1" x:Name="SourceEditor" FontFamily="Malgun Gothic" FontSize="18" ShowLineNumbers="True" WordWrap="True" Padding="7,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="원문 텍스트 편집기"/>
          <Border Grid.Row="2" Background="#F7F8FA" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,0"><TextBlock Text="태그는 파란색으로 표시됩니다. 블록별 편집 이력이 유지됩니다." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></Border>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" ResizeBehavior="PreviousAndNext"/>
      <Border Grid.Column="4" BorderBrush="{StaticResource Line}" BorderThickness="1"><Grid>
        <local:BraillePane x:Name="Braille"/>
        <Border x:Name="DetachedPlaceholder" Visibility="Collapsed" Background="#F4F6F8"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="점자 창이 분리되어 있습니다" FontSize="17"/><TextBlock Text="독립 창에서도 같은 블록을 편집합니다." Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><Button Content="이 창으로 합치기" Tag="detach" Click="Action_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Border>
      </Grid></Border>
    </Grid>
  </DockPanel>
</Window>
