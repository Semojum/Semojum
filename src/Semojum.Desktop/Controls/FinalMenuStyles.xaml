<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svg="http://sharpvectors.codeplex.com/svgc/" xmlns:local="clr-namespace:Semojum.Desktop.Controls">
  <Style x:Key="FinalContextSeparator" TargetType="Separator">
    <Setter Property="Height" Value="9"/><Setter Property="Margin" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="#EAEAEA" Height="1" Margin="7,0" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalContextItem" TargetType="MenuItem">
    <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Grid>
        <Border x:Name="Surface" Background="Transparent" Margin="2,0" Padding="4,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#5F5F5F" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <svg:SvgViewbox x:Name="Arrow" Grid.Column="3" Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/text-context-chevron.svg" Width="16" Height="16" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
        </Border>
        <Popup x:Name="PART_Popup" Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
          <Border Width="220" Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="3,7"><ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EFF6FC"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalContextMenu" TargetType="ContextMenu">
    <Setter Property="Width" Value="248"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="White" BorderBrush="#D1D1D1" BorderThickness="1" Padding="0,7"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalDesktopMenuItem" TargetType="MenuItem">
    <Setter Property="Height" Value="24"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#1A1A1A"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Grid>
        <Border x:Name="Surface" Background="Transparent" Padding="10,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" Width="16" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/><TextBlock x:Name="Arrow" Text="▸" Visibility="Collapsed" Margin="2,0,0,0"/></StackPanel>
            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#5F5F5F" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
        </Border>
        <Popup x:Name="PART_Popup" Placement="Custom" local:ShadowPopupPlacement.Enabled="True" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False">
          <Border x:Name="PopupSurface" Width="220" Margin="20" Background="#FBFBFB" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6" Padding="3,7"><Border.Effect><DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="8" Direction="270" Opacity="0.14"/></Border.Effect><ScrollViewer MaxHeight="720" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F0F0F0"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
        <Trigger Property="Role" Value="TopLevelHeader"><Setter Property="Height" Value="32"/><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/><Setter TargetName="PopupSurface" Property="Width" Value="222"/><Setter TargetName="PopupSurface" Property="Margin" Value="0"/><Setter TargetName="PopupSurface" Property="Effect" Value="{x:Null}"/><Setter TargetName="PopupSurface" Property="CornerRadius" Value="0"/><Setter TargetName="PopupSurface" Property="Padding" Value="0,5"/><Setter TargetName="PopupSurface" Property="Background" Value="White"/><Setter TargetName="PopupSurface" Property="BorderBrush" Value="#D1D1D1"/><Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/><Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FinalDesktopNestedItem" TargetType="MenuItem" BasedOn="{StaticResource FinalDesktopMenuItem}"><Setter Property="Height" Value="32"/></Style>
</ResourceDictionary>
