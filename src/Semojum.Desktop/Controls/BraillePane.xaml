<UserControl x:Class="Semojum.Desktop.Controls.BraillePane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:local="clr-namespace:Semojum.Desktop.Controls">
  <DockPanel Background="White">
    <Border x:Name="Header" DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Height="32"><DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock x:Name="LayoutLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,8,0" ToolTip="{Binding Text, ElementName=StateLabel}"/>
        <Button x:Name="DetachButton" Content="⧉" ToolTip="점자 창 분리 / 합치기" Click="Detach_Click" Style="{StaticResource PanelButton}"/>
        <Button Content="×" ToolTip="점자 패널 숨기기" Click="Hide_Click" Style="{StaticResource PanelButton}"/>
      </StackPanel>
      <Border DockPanel.Dock="Left" Style="{StaticResource PanelNumber}"><TextBlock x:Name="PanelNumber" Text="3" Foreground="White" FontSize="12" HorizontalAlignment="Center"/></Border>
      <TextBlock x:Name="PanelTitle" Text="점자" FontSize="12"/>
    </DockPanel></Border>
    <local:LineTranslation x:Name="PreviewStrip" DockPanel.Dock="Bottom" Height="90" Visibility="Collapsed"/>
    <TextBlock x:Name="StateLabel" Visibility="Collapsed"/>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition x:Name="GridHeight" Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <DockPanel Margin="8,4" Visibility="Collapsed"><CheckBox x:Name="GridToggle" Content="모눈 보기" IsChecked="True" Click="GridToggle_Click"/>
        <TextBlock Text="  드래그·Shift 선택 · 6점 입력 · Ctrl+Z" FontSize="11" Foreground="Gray" ToolTip="BRF와 동일한 판면입니다. 본문을 직접 편집합니다. 회색 조판 영역은 자동 생성됩니다."/></DockPanel>
      <local:BrailleGridView x:Name="GridView" Grid.Row="1"/>
      <ae:TextEditor x:Name="Editor" Grid.Row="3" Visibility="Collapsed" FontFamily="Segoe UI Symbol" FontSize="22" Padding="8,4" ShowLineNumbers="True" WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="점자 편집 모델"/>
    </Grid>
  </DockPanel>
</UserControl>
