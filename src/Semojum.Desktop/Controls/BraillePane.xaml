<UserControl x:Class="Semojum.Desktop.Controls.BraillePane" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:local="clr-namespace:Semojum.Desktop.Controls">
  <DockPanel Background="White">
    <Border x:Name="Header" DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Height="32"><DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock x:Name="LayoutLabel" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,8,0" ToolTip="{Binding Text, ElementName=StateLabel}"/>
        <Button x:Name="DetachButton" Content="⧉" ToolTip="점자 창 분리 / 합치기" Click="Detach_Click" Style="{StaticResource PanelButton}"/>
        <Button Content="×" ToolTip="점자 패널 숨기기" Click="Hide_Click" Style="{StaticResource PanelButton}"/>
      </StackPanel>
      <Border DockPanel.Dock="Left" Style="{StaticResource PanelNumber}"><TextBlock Text="3" Foreground="White" FontSize="12" HorizontalAlignment="Center"/></Border>
      <TextBlock Text="점자" FontSize="12"/>
    </DockPanel></Border>
    <local:LineTranslation x:Name="PreviewStrip" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
    <TextBlock x:Name="StateLabel" Visibility="Collapsed"/>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="GridHeight" Height="2*"/><RowDefinition Height="3"/><RowDefinition Height="*" MinHeight="90"/></Grid.RowDefinitions>
      <DockPanel Margin="8,4"><CheckBox x:Name="GridToggle" Content="모눈 보기" IsChecked="True" Click="GridToggle_Click"/>
        <TextBlock Text="  칸 선택 → 아래에서 편집" FontSize="11" Foreground="Gray" ToolTip="편집 위치를 보여 주는 근사 판면입니다. 머리말·꼬리말·페이지행을 포함한 최종 결과는 점자 면 미리보기에서 확인하세요."/></DockPanel>
      <local:BrailleGridView x:Name="GridView" Grid.Row="1"/>
      <GridSplitter Grid.Row="2" Height="3" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="#D6D6D6"/>
      <ae:TextEditor x:Name="Editor" Grid.Row="3" FontFamily="Segoe UI Symbol" FontSize="22" Padding="8,4" ShowLineNumbers="True" WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="점자 편집기"/>
    </Grid>
  </DockPanel>
</UserControl>
