<UserControl x:Class="Semojum.Desktop.Controls.LineTranslation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="64">
  <Grid Background="#FAFAFA">
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#F3F3F3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="12,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource PanelButton}" ToolTip="줄번역 숨기기" AutomationProperties.Name="줄번역 숨기기" Click="Close_Click"/>
        <TextBlock x:Name="LineLabel" Text="줄번역" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
      </DockPanel>
    </Border>
    <TextBlock x:Name="Cells" Grid.Row="1" Margin="12,0" FontFamily="Segoe UI Symbol" FontSize="22" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
</UserControl>
