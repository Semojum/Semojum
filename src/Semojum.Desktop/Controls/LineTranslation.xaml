<UserControl x:Class="Semojum.Desktop.Controls.LineTranslation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="64">
  <Grid Background="#FAFAFA">
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="40"/></Grid.RowDefinitions>
    <Border Background="#F3F3F3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="8,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource PanelButton}" ToolTip="줄번역 숨기기" AutomationProperties.Name="줄번역 숨기기" Click="Close_Click"/>
        <TextBlock DockPanel.Dock="Right" Text="보기 › 줄번역으로 켜고 끄기" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,16,0"/>
        <TextBlock x:Name="LineLabel" Text="줄번역" FontSize="12"/>
      </DockPanel>
    </Border>
    <TextBlock x:Name="Cells" Grid.Row="1" Margin="8,0" FontFamily="Segoe UI Symbol" FontSize="22" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
</UserControl>
