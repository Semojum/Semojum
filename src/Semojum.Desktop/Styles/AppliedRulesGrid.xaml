<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GridBehavior.xaml"/></ResourceDictionary.MergedDictionaries>
  <!-- This screen owns its header, cell, selection, and grid appearance. -->
  <Style x:Key="AppliedRulesHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F4F6F9"/><Setter Property="Foreground" Value="#5F5F5F"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="8,0"/>
    <Setter Property="BorderBrush" Value="#EAEAEA"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style x:Key="AppliedRulesCell" TargetType="DataGridCell" BasedOn="{StaticResource GridCellBehavior}">
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="Foreground" Value="#1A1A1A"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EFF6FC"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="AppliedRulesGrid" TargetType="DataGrid" BasedOn="{StaticResource GridBehavior}">
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EAEAEA"/><Setter Property="ColumnHeaderHeight" Value="24"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource AppliedRulesHeader}"/><Setter Property="CellStyle" Value="{StaticResource AppliedRulesCell}"/>
  </Style>
</ResourceDictionary>
