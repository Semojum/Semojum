<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Semojum.Mockup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Semojum.Core/Semojum.Core.csproj" />
    <ProjectReference Include="../Semojum.UI.Common/Semojum.UI.Common.csproj" />
    <ProjectReference Include="../Semojum.Feature.Account/Semojum.Feature.Account.csproj" />
    <ProjectReference Include="../Semojum.Feature.Board/Semojum.Feature.Board.csproj" />
    <ProjectReference Include="../Semojum.Feature.Board.Wpf/Semojum.Feature.Board.Wpf.csproj" />
    <ProjectReference Include="../Semojum.Feature.Rules/Semojum.Feature.Rules.csproj" />
    <ProjectReference Include="../Semojum.Feature.Settings/Semojum.Feature.Settings.csproj" />
    <ProjectReference Include="../Semojum.Feature.Editor/Semojum.Feature.Editor.csproj" />
    <ProjectReference Include="../Semojum.Feature.Editor.Wpf/Semojum.Feature.Editor.Wpf.csproj" />
    <ProjectReference Include="../Semojum.Feature.Institution/Semojum.Feature.Institution.csproj" />
    <ProjectReference Include="../Semojum.Feature.Institution.Wpf/Semojum.Feature.Institution.Wpf.csproj" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <Resource Include="Assets/Figma/*.svg" />
    <Content Include="Assets/Fonts/*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/Inter-LICENSE.txt" Link="licenses/Inter-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/NotoSansKR-LICENSE.txt" Link="licenses/NotoSansKR-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/RobotoMono-LICENSE.txt" Link="licenses/RobotoMono-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup><Content Include="../../scripts/engine-entry.py" Link="engine-adapter/engine-entry.py" CopyToOutputDirectory="PreserveNewest" /><Content Include="../../scripts/editor_composition.py" Link="engine-adapter/editor_composition.py" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
