<UserControl x:Class="Semojum.Desktop.Controls.LineTranslation" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:svg="http://sharpvectors.codeplex.com/svgc/" Height="64">
  <Grid Background="#F9F9F9">
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#F3F3F3" BorderBrush="#EAEAEA" BorderThickness="0,1,0,1" Padding="12,0,4,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Width="24" Height="22" MinWidth="0" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="줄번역 숨기기" AutomationProperties.Name="줄번역 숨기기" Click="Close_Click">
          <Button.Template><ControlTemplate TargetType="Button">
            <Border x:Name="CloseSurface" Background="{TemplateBinding Background}" BorderThickness="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#EFF6FC"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CloseSurface" Property="BorderBrush" Value="#005FB8"/><Setter TargetName="CloseSurface" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
          <svg:SvgViewbox Source="pack://application:,,,/Semojum.Mockup;component/Assets/Figma/line-preview-close.svg" Width="16" Height="16" Stretch="None" IsHitTestVisible="False"/>
        </Button>
        <TextBlock x:Name="LineLabel" Text="줄번역" FontSize="14" FontWeight="Bold" Foreground="#5F5F5F"/>
      </DockPanel>
    </Border>
    <Border Height="1" VerticalAlignment="Top" Background="#D1D1D1" IsHitTestVisible="False"/>
    <TextBlock x:Name="Cells" Grid.Row="1" Margin="12,12,12,0" VerticalAlignment="Top" FontFamily="Segoe UI Symbol" FontSize="22" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </Grid>
</UserControl>
