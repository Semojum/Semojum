<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Builds a per-user MSI from the portable app folder: dotnet build installer -p:AppDir=<publish folder>. -->
  <PropertyGroup>
    <OutputName>Semojum-win-x64</OutputName>
    <Platform>x64</Platform>
    <AppDir Condition="'$(AppDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\Semojum-win-x64</AppDir>
    <DefineConstants>ProductVersion=$(Version)</DefineConstants>
    <!-- Per-user files under %LocalAppData% keep their file key paths; ICE38/64/91 only apply to roaming profiles.
         ICE60 flags versioned runtime files without a language, which language-neutral binaries do not have. -->
    <SuppressIces>ICE38;ICE60;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <BindPath Include="$(AppDir)" BindName="app" />
  </ItemGroup>
</Project>
